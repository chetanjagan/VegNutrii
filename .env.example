# Copy to .env and fill in. Never commit .env.

# Required in production: a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite for local use; Postgres URL in production (postgres://user:pass@host:5432/db works)
DATABASE_URL=sqlite:///vegnutri.db

APP_NAME=VegNutri
APP_URL=http://localhost:5000
COMPANY_NAME=VegNutri
SUPPORT_EMAIL=support@example.com
# Comma-separated emails that get /admin on login
ADMIN_EMAILS=

# AI coach (Groq key from console.groq.com/keys, starts with gsk_; never shown to users)
GROQ_API_KEY=
# Optional: force one model id (see console.groq.com/docs/models). Leave empty for automatic.
GROQ_MODEL=

# Razorpay (dashboard.razorpay.com > Account & Settings > API keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Growth: free Pro trial for new sign-ups (0 turns it off), longer trial for invited friends,
# and the Pro days someone earns when a friend they invited pays.
TRIAL_DAYS=7
REFERRAL_TRIAL_DAYS=14
REFERRAL_REWARD_DAYS=30
# Shared secret for the weekly email job. Make a long random string and put the SAME value
# in GitHub > Settings > Secrets and variables > Actions as TASK_TOKEN.
TASK_TOKEN=

# Email (password resets and the weekly summary).
# Easiest: a Brevo API key (brevo.com, free 300 emails/day). It sends over HTTPS, so it works even
# where SMTP ports are blocked. MAIL_FROM must be a sender address you've verified in Brevo.
BREVO_API_KEY=
# Or use SMTP instead. With neither set, emails are printed to the log.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=VegNutri <no-reply@example.com>
MAIL_USE_TLS=1

# Set to 1 when served over HTTPS (production)
SESSION_COOKIE_SECURE=0
# Rate-limit storage. memory:// is fine for one server; use redis://... with several.
RATELIMIT_STORAGE_URI=memory://

# Local development only
FLASK_DEBUG=0
# Free fake upgrades for testing the paywall locally. Only works with FLASK_DEBUG=1 and no Razorpay keys.
DEMO_BILLING=0
